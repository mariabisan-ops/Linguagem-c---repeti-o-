#include <stdio.h>

int main (){
    int n1, n2, soma = 0;
    printf ("digite primeiro valor:\n");
    scanf ("%d", &n1);
    printf ("digite segundo valor:\n");
    scanf ("%d", &n2);

    if (n2>n1){
        for (int i=n1; i<=n2; i++){
            soma = soma + i;
        }
    }
    else {
        for (int i=n2; i<=n1; i++){
            soma = soma + i;
        }
    }

    printf ("o valor da soma é: %d", soma);

}
