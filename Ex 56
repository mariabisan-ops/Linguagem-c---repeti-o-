#include <stdio.h>

int main (){
    int n;
    printf ("digite o valor desejado:");
    scanf ("%d", &n);

    while (n<1 || n>10){
        printf ("valor inválido.\n digite novamente:");
        scanf ("%d", &n);
    }

    for (int i=1; i<=10; i++){
        printf ("%d x %d = %d\n", n,i,i*n);
    }
}
