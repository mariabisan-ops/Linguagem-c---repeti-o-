#include <stdio.h>

int main (){
    int n, contador = 0, fora = 0;

    for (int i = 1; i<=10, i++){
        printf ("digite um valor:");
        scanf ("%d", &n);
        if (10<=n && n<=20){
            contador++;
        }
        else {
            fora++;
        }
        
    }
    printf ("%d valores no intervalo:", contador);
    printf ("%D valores fora do intervalo:", fora);
}
